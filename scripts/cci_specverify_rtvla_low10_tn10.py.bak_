#!/usr/bin/env python3
"""Launch Realtime-VLA-style SpecVerify on RoboTwin clean low10 tasks.

This script is intended to run on cci. It keeps code, experiment artifacts, and
durable result summaries under /mnt/afs/intern/manlichen/ivan/zhoujunl.
"""

from __future__ import annotations

import argparse
import csv
import json
import os
import signal
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path


ROOT = Path("/mnt/afs/intern/manlichen/ivan/zhoujunl")
CODE = ROOT / "Wam_Speed_up" / "lingbot-va-specverify"
ROBOTWIN_ROOT = ROOT / "Wam_Speed_up" / "RoboTwin"
EXPERIMENT_ROOT = ROOT / "experiments" / "Wam_Speed_up"
RESULT_ROOT = ROOT / "result" / "Wam_Speed_up"
PYTHON_PKGS = ROOT / "env" / "python_pkgs"
TORCH29_CLEAN_PKGS = ROOT / "env" / "torch29_clean_pkgs"
CUROBO_V1 = ROOT / "env" / "curobo-v0.7.8" / "src"
NINJA_BIN = ROOT / "env" / "ninja-build" / "extract" / "usr" / "bin"
TORCH_EXTENSIONS = ROOT / "env" / "torch_extensions"
CUDA_RUNTIME_LIB = Path("/usr/local/cuda-12.1/targets/x86_64-linux/lib")
NVIDIA_550_ROOT = ROOT / "env" / "nvidia-550.90.07-jammy" / "extract"
NVIDIA_550_LIB = NVIDIA_550_ROOT / "usr" / "lib" / "x86_64-linux-gnu"
NVIDIA_550_ICD = NVIDIA_550_ROOT / "usr" / "share" / "vulkan" / "icd.d" / "nvidia_icd.json"

TASKS = [
    "hanging_mug",
    "turn_switch",
    "place_can_basket",
    "open_microwave",
    "press_stapler",
    "put_object_cabinet",
    "stack_bowls_three",
    "put_bottles_dustbin",
    "dump_bin_bigbin",
    "pick_diverse_bottles",
]

TEACHER_CLEAN_RATE = {
    "hanging_mug": 0.40,
    "turn_switch": 0.44,
    "place_can_basket": 0.81,
    "open_microwave": 0.82,
    "press_stapler": 0.85,
    "put_object_cabinet": 0.85,
    "stack_bowls_three": 0.86,
    "put_bottles_dustbin": 0.87,
    "dump_bin_bigbin": 0.89,
    "pick_diverse_bottles": 0.89,
}


def ensure_dirs(*paths: Path) -> None:
    for root in paths:
        for name in ["logs", "results", "server", "scripts"]:
            (root / name).mkdir(parents=True, exist_ok=True)


def base_env(gpu: int, *, use_torch29: bool = True) -> dict[str, str]:
    env = os.environ.copy()
    env["CUDA_VISIBLE_DEVICES"] = str(gpu)
    env["ROBOTWIN_ROOT"] = str(ROBOTWIN_ROOT)
    python_paths = []
    if use_torch29:
        python_paths.append(str(TORCH29_CLEAN_PKGS))
    python_paths.extend([str(PYTHON_PKGS), str(CUROBO_V1)])
    python_paths.append(env.get("PYTHONPATH", ""))
    env["PYTHONPATH"] = ":".join(p for p in python_paths if p)
    env["PATH"] = f"{NINJA_BIN}:/usr/local/cuda/bin:{env.get('PATH', '')}"
    env["TORCH_EXTENSIONS_DIR"] = str(TORCH_EXTENSIONS)
    env["LIBRARY_PATH"] = f"{CUDA_RUNTIME_LIB}:{env.get('LIBRARY_PATH', '')}"
    env["LD_LIBRARY_PATH"] = f"{NVIDIA_550_LIB}:{CUDA_RUNTIME_LIB}:{env.get('LD_LIBRARY_PATH', '')}"
    env["VK_ICD_FILENAMES"] = str(NVIDIA_550_ICD)
    env["TOKENIZERS_PARALLELISM"] = "false"
    env["DIFFUSERS_DISABLE_BITSANDBYTES"] = "1"
    env["PYTHONWARNINGS"] = "ignore::UserWarning"
    env["XLA_PYTHON_CLIENT_MEM_FRACTION"] = "0.9"
    env["PYTHONUNBUFFERED"] = "1"
    return env


def screen_running(name: str) -> bool:
    out = subprocess.run(["screen", "-ls"], capture_output=True, text=True, check=False).stdout
    return any(name in line and ("Detached" in line or "Attached" in line) for line in out.splitlines())


def wait_for_screen_to_finish(screen_name: str | None, timeout_sec: int) -> None:
    if not screen_name:
        return
    deadline = time.time() + timeout_sec
    while screen_running(screen_name):
        if time.time() > deadline:
            raise TimeoutError(f"timed out waiting for screen {screen_name!r}")
        print(f"[launcher] waiting for active screen {screen_name!r} to finish...", flush=True)
        time.sleep(60)


def start_server(
    run_root: Path,
    *,
    name: str,
    config_name: str,
    gpu: int,
    port: int,
    master_port: int,
) -> subprocess.Popen:
    log_path = run_root / "logs" / f"{name}_server_g{gpu}.log"
    log = log_path.open("a", buffering=1)
    cmd = [
        sys.executable,
        "-m",
        "torch.distributed.run",
        "--nproc_per_node",
        "1",
        "--master_port",
        str(master_port),
        "wan_va/wan_va_server.py",
        "--config-name",
        config_name,
        "--save_root",
        str(run_root / "server" / name),
        "--port",
        str(port),
    ]
    print(f"[launcher] start {name} server gpu={gpu} port={port} config={config_name}", flush=True)
    return subprocess.Popen(cmd, cwd=str(CODE), env=base_env(gpu, use_torch29=True), stdout=log, stderr=subprocess.STDOUT)


def read_task_metric(root: Path, task: str) -> dict[str, object]:
    metric_path = root / "results" / "stseed-10000" / "metrics" / task / "res.json"
    if not metric_path.exists():
        return {
            "task": task,
            "succ_num": 0,
            "total_num": 0,
            "succ_rate": 0.0,
            "teacher_clean_rate": TEACHER_CLEAN_RATE[task],
            "delta_vs_teacher": -TEACHER_CLEAN_RATE[task],
            "status": "missing",
        }
    with metric_path.open() as f:
        data = json.load(f)
    total = int(data.get("total_num", 0))
    succ = int(data.get("succ_num", 0))
    rate = float(data.get("succ_rate", succ / total if total else 0.0))
    return {
        "task": task,
        "succ_num": succ,
        "total_num": total,
        "succ_rate": rate,
        "teacher_clean_rate": TEACHER_CLEAN_RATE[task],
        "delta_vs_teacher": rate - TEACHER_CLEAN_RATE[task],
        "status": "ok",
    }


ACTION_SOURCES = {"draft", "teacher_full", "teacher_fallback"}
CACHE_SOURCES = {"compute_kv_cache", "compute_kv_cache_lazy_reference", "teacher_cache_sync", "reset"}


def _latency_stats(values: list[float]) -> dict[str, float | int | None]:
    if not values:
        return {"count": 0, "mean_sec": None, "p50_sec": None, "p90_sec": None}
    xs = sorted(values)

    def q(frac: float) -> float:
        idx = min(len(xs) - 1, max(0, int(round((len(xs) - 1) * frac))))
        return xs[idx]

    return {
        "count": len(xs),
        "mean_sec": sum(xs) / len(xs),
        "p50_sec": q(0.50),
        "p90_sec": q(0.90),
    }


def specverify_metrics(log_path: Path) -> dict[str, object]:
    counts = {
        "draft_accept": 0,
        "teacher_full": 0,
        "teacher_fallback": 0,
        "phase_fallback": 0,
        "verify_reject": 0,
    }
    source_latencies: dict[str, list[float]] = {}
    action_latencies: list[float] = []
    cache_latencies: list[float] = []
    if not log_path.exists():
        return {
            "counts": counts,
            "rates": {
                "action_rounds": 0,
                "draft_accept_rate": None,
                "teacher_total_rate": None,
                "teacher_full_rate": None,
                "teacher_fallback_rate": None,
                "phase_fallback_rate": None,
                "verify_reject_rate": None,
            },
            "latency": {
                "action_rounds": _latency_stats([]),
                "cache_updates": _latency_stats([]),
                "by_source": {},
            },
        }
    with log_path.open() as f:
        for line in f:
            try:
                row = json.loads(line)
            except json.JSONDecodeError:
                continue
            source = row.get("source")
            elapsed = row.get("elapsed_sec")
            if isinstance(source, str) and isinstance(elapsed, (int, float)):
                source_latencies.setdefault(source, []).append(float(elapsed))
                if source in ACTION_SOURCES:
                    action_latencies.append(float(elapsed))
                elif source in CACHE_SOURCES:
                    cache_latencies.append(float(elapsed))
            if source == "draft":
                counts["draft_accept"] += 1
            elif source == "teacher_full":
                counts["teacher_full"] += 1
            elif source == "teacher_fallback":
                counts["teacher_fallback"] += 1
                reason = row.get("fallback_reason")
                if reason == "phase_gripper_switch":
                    counts["phase_fallback"] += 1
                elif reason == "verify_reject":
                    counts["verify_reject"] += 1
    action_rounds = counts["draft_accept"] + counts["teacher_full"] + counts["teacher_fallback"]

    def rate(value: int) -> float | None:
        return value / action_rounds if action_rounds else None

    return {
        "counts": counts,
        "rates": {
            "action_rounds": action_rounds,
            "draft_accept_rate": rate(counts["draft_accept"]),
            "teacher_total_rate": rate(counts["teacher_full"] + counts["teacher_fallback"]),
            "teacher_full_rate": rate(counts["teacher_full"]),
            "teacher_fallback_rate": rate(counts["teacher_fallback"]),
            "phase_fallback_rate": rate(counts["phase_fallback"]),
            "verify_reject_rate": rate(counts["verify_reject"]),
        },
        "latency": {
            "action_rounds": _latency_stats(action_latencies),
            "cache_updates": _latency_stats(cache_latencies),
            "by_source": {source: _latency_stats(values) for source, values in sorted(source_latencies.items())},
        },
    }


def specverify_counts(log_path: Path) -> dict[str, int]:
    return specverify_metrics(log_path)["counts"]  # kept for older summaries/tests


def summarize(
    run_root: Path,
    result_root: Path,
    *,
    start_time: str,
    end_time: str | None,
    experiment_content: str,
    specverify_log: Path,
    test_num: int,
) -> dict[str, object]:
    rows = [read_task_metric(run_root, task) for task in TASKS]
    total = sum(int(r["total_num"]) for r in rows)
    success = sum(int(r["succ_num"]) for r in rows)
    rate = success / total if total else 0.0
    teacher_total_rate = sum(TEACHER_CLEAN_RATE[t] for t in TASKS) / len(TASKS)
    metrics = specverify_metrics(specverify_log)
    counts = metrics["counts"]
    rates = metrics["rates"]
    latency = metrics["latency"]
    summary = {
        "run_root": str(run_root),
        "result_root": str(result_root),
        "start_time": start_time,
        "end_time": end_time,
        "experiment_content": experiment_content,
        "tasks": TASKS,
        "test_num_per_task": test_num,
        "success": success,
        "total": total,
        "success_rate": rate,
        "teacher_low10_mean_rate": teacher_total_rate,
        "delta_vs_teacher_low10_mean": rate - teacher_total_rate,
        "specverify_counts": counts,
        "specverify_rates": rates,
        "latency_summary": latency,
        "updated_at": datetime.now().isoformat(timespec="seconds"),
        "rows": rows,
    }
    for root in (run_root, result_root):
        root.mkdir(parents=True, exist_ok=True)
        (root / "summary_latest.json").write_text(json.dumps(summary, indent=2), encoding="utf-8")
        with (root / "per_task_success.csv").open("w", newline="", encoding="utf-8") as f:
            writer = csv.DictWriter(
                f,
                fieldnames=[
                    "task",
                    "succ_num",
                    "total_num",
                    "succ_rate",
                    "teacher_clean_rate",
                    "delta_vs_teacher",
                    "status",
                ],
            )
            writer.writeheader()
            writer.writerows(rows)
        lines = [
            "# SpecVerify Realtime-VLA Triple On LingBot-VA / FlashWAM Low10 TN10",
            "",
            f"- Start: {start_time}",
            f"- End: {end_time or 'RUNNING'}",
            f"- Experiment: {experiment_content}",
            f"- Run root: `{run_root}`",
            f"- Result root: `{result_root}`",
            "- Draft: FlashWAM-RoboTwin v1/a1",
            "- Teacher/verifier/fallback: configured LingBot-VA server; see experiment line",
            "- Verify: action flow endpoint check, tau={150,300}, delta=0.15",
            "- Runtime controls: prefix {0,16,32}, phase-aware gripper fallback, PF=2 full-path refresh",
            f"- Current success: {success}/{total} = {rate * 100:.2f}%",
            f"- Teacher low10 mean reference: {teacher_total_rate * 100:.2f}%",
            f"- Delta vs teacher low10 mean: {(rate - teacher_total_rate) * 100:+.2f} pp",
            f"- SpecVerify counts: `{counts}`",
            f"- SpecVerify rates: `{rates}`",
            f"- Action latency: `{latency['action_rounds']}`",
            f"- Cache/update latency: `{latency['cache_updates']}`",
            "",
            "| Task | Success | Total | Rate | Teacher Clean | Delta | Status |",
            "| --- | ---: | ---: | ---: | ---: | ---: | --- |",
        ]
        for row in rows:
            lines.append(
                f"| {row['task']} | {row['succ_num']} | {row['total_num']} | "
                f"{float(row['succ_rate']) * 100:.2f}% | "
                f"{float(row['teacher_clean_rate']) * 100:.2f}% | "
                f"{float(row['delta_vs_teacher']) * 100:+.2f} pp | {row['status']} |"
            )
        (root / "summary.md").write_text("\n".join(lines) + "\n", encoding="utf-8")
    return summary


def run_task(
    run_root: Path,
    result_root: Path,
    *,
    task: str,
    client_gpu: int,
    draft_port: int,
    teacher_port: int,
    test_num: int,
    specverify_log: Path,
    teacher_cache_mode: str,
    disable_prime_draft_on_teacher_full: bool,
) -> tuple[int, str]:
    log_path = run_root / "logs" / f"client_{task}.log"
    result_task_log = result_root / "logs" / f"client_{task}.log"
    # Keep the RobotWin client on the same system-torch/cuRobo environment used
    # by the successful Flash-WAM reproduction run. The torch 2.9 overlay is
    # only required by the LingBot/FlashWAM server code path.
    env = base_env(client_gpu, use_torch29=False)
    cmd = [
        sys.executable,
        "-m",
        "evaluation.robotwin.eval_polict_client_openpi",
        "--config",
        "policy/ACT/deploy_policy.yml",
        "--host",
        "127.0.0.1",
        "--specverify_enable",
        "--draft_port",
        str(draft_port),
        "--teacher_port",
        str(teacher_port),
        "--specverify_pf",
        "2",
        "--specverify_threshold",
        "0.15",
        "--specverify_tau",
        "150",
        "300",
        "--specverify_teacher_cache_mode",
        teacher_cache_mode,
        "--specverify_log",
        str(specverify_log),
        "--overrides",
        "--task_name",
        task,
        "--task_config",
        "demo_clean",
        "--train_config_name",
        "0",
        "--model_name",
        "0",
        "--ckpt_setting",
        "SpecVerify-FlashWAM-draft-LingBot-teacher-RTVLA-v1",
        "--seed",
        "0",
        "--policy_name",
        "ACT",
        "--save_root",
        str(run_root / "results"),
        "--video_guidance_scale",
        "5",
        "--action_guidance_scale",
        "1",
        "--test_num",
        str(test_num),
    ]
    if disable_prime_draft_on_teacher_full:
        cmd.insert(cmd.index("--overrides"), "--specverify_disable_prime_draft_on_teacher_full")
    with log_path.open("a", buffering=1) as log:
        log.write(f"[task] {task} client_gpu={client_gpu} tn={test_num}\n")
        log.write("[command] " + " ".join(cmd) + "\n")
        proc = subprocess.run(cmd, cwd=str(CODE), env=env, stdout=log, stderr=subprocess.STDOUT)
    result_task_log.write_text(log_path.read_text(errors="replace"), encoding="utf-8")
    metric = read_task_metric(run_root, task)
    if proc.returncode != 0 and int(metric["total_num"]) >= test_num:
        return 0, f"POST_RESULT_RC_{proc.returncode}"
    return proc.returncode, "ok" if proc.returncode == 0 else f"RC_{proc.returncode}"


def launch(args: argparse.Namespace) -> None:
    run_root = Path(args.run_root)
    result_root = Path(args.result_root)
    ensure_dirs(run_root, result_root)
    queued_at = datetime.now().isoformat(timespec="seconds")
    content = (
        "Realtime-VLA first-version speculative verification on LingBot-VA: "
        "FlashWAM v1/a1 draft, LingBot v2/a4 teacher action-flow verifier, "
        "prefix {0,16,32}, phase-aware fallback, PF=2, low10 clean TN10. "
        f"Teacher config={args.teacher_config_name}; "
        f"Teacher cache mode={args.teacher_cache_mode}; "
        f"prime draft on teacher full={not args.disable_prime_draft_on_teacher_full}."
    )
    (run_root / "command.sh").write_text(" ".join(sys.argv) + "\n", encoding="utf-8")
    (result_root / "command.sh").write_text(" ".join(sys.argv) + "\n", encoding="utf-8")
    (run_root / "queued_at.txt").write_text(queued_at + "\n", encoding="utf-8")
    (result_root / "queued_at.txt").write_text(queued_at + "\n", encoding="utf-8")
    (run_root / "experiment_content.txt").write_text(content + "\n", encoding="utf-8")
    (result_root / "experiment_content.txt").write_text(content + "\n", encoding="utf-8")
    (run_root / "task_list.json").write_text(json.dumps(TASKS, indent=2), encoding="utf-8")
    (result_root / "task_list.json").write_text(json.dumps(TASKS, indent=2), encoding="utf-8")

    wait_for_screen_to_finish(args.wait_screen, args.wait_timeout_sec)
    start_time = datetime.now().isoformat(timespec="seconds")
    (run_root / "start_time.txt").write_text(start_time + "\n", encoding="utf-8")
    (result_root / "start_time.txt").write_text(start_time + "\n", encoding="utf-8")
    summarize(run_root, result_root, start_time=start_time, end_time=None, experiment_content=content, specverify_log=run_root / "logs" / "specverify_metrics.jsonl", test_num=args.test_num)

    servers: list[subprocess.Popen] = []
    try:
        draft_port = args.port_base
        teacher_port = args.port_base + 1
        servers.append(start_server(
            run_root,
            name="draft_flashwam",
            config_name="robotwin_flashwam",
            gpu=args.draft_gpu,
            port=draft_port,
            master_port=args.master_port_base,
        ))
        servers.append(start_server(
            run_root,
            name="teacher_lingbot",
            config_name=args.teacher_config_name,
            gpu=args.teacher_gpu,
            port=teacher_port,
            master_port=args.master_port_base + 1,
        ))
        print(f"[launcher] warming servers for {args.server_warmup_sec}s", flush=True)
        time.sleep(args.server_warmup_sec)

        specverify_log = run_root / "logs" / "specverify_metrics.jsonl"
        for idx, task in enumerate(TASKS, start=1):
            print(f"[launcher] task {idx}/{len(TASKS)} {task}", flush=True)
            rc, status = run_task(
                run_root,
                result_root,
                task=task,
                client_gpu=args.client_gpu,
                draft_port=draft_port,
                teacher_port=teacher_port,
                test_num=args.test_num,
                specverify_log=specverify_log,
                teacher_cache_mode=args.teacher_cache_mode,
                disable_prime_draft_on_teacher_full=args.disable_prime_draft_on_teacher_full,
            )
            print(f"[launcher] task {task} status={status}", flush=True)
            summarize(
                run_root,
                result_root,
                start_time=start_time,
                end_time=None,
                experiment_content=content,
                specverify_log=specverify_log,
                test_num=args.test_num,
            )
            if rc != 0:
                raise RuntimeError(f"task {task} failed with {status}")

        end_time = datetime.now().isoformat(timespec="seconds")
        summarize(
            run_root,
            result_root,
            start_time=start_time,
            end_time=end_time,
            experiment_content=content,
            specverify_log=specverify_log,
            test_num=args.test_num,
        )
        print("[launcher] complete", flush=True)
    finally:
        for proc in servers:
            if proc.poll() is None:
                proc.send_signal(signal.SIGTERM)
        time.sleep(5)
        for proc in servers:
            if proc.poll() is None:
                proc.kill()


def main() -> None:
    global TASKS
    parser = argparse.ArgumentParser()
    parser.add_argument("--run-root", default=str(EXPERIMENT_ROOT / "20260617_specverify_rtvla_low10_tn10"))
    parser.add_argument("--result-root", default=str(RESULT_ROOT / "20260617_specverify_rtvla_low10_tn10"))
    parser.add_argument("--draft-gpu", type=int, default=0)
    parser.add_argument("--teacher-gpu", type=int, default=1)
    parser.add_argument("--client-gpu", type=int, default=2)
    parser.add_argument("--port-base", type=int, default=31380)
    parser.add_argument("--master-port-base", type=int, default=31480)
    parser.add_argument("--server-warmup-sec", type=int, default=300)
    parser.add_argument("--test-num", type=int, default=10)
    parser.add_argument(
        "--teacher-config-name",
        default="robotwin_lingbot_v2a4_teacher",
        help="LingBot teacher server config. Default uses direct step compression v2/a4.",
    )
    parser.add_argument(
        "--teacher-cache-mode",
        choices=["sync", "lazy_reference"],
        default="sync",
        help="sync keeps teacher cache updated every real-history cache update; lazy_reference only syncs before full/fallback teacher paths.",
    )
    parser.add_argument(
        "--disable-prime-draft-on-teacher-full",
        action="store_true",
        help="Skip the extra draft action request on teacher-full rounds.",
    )
    parser.add_argument("--wait-screen", default="lingbotva_top10_chunks_20260617")
    parser.add_argument("--wait-timeout-sec", type=int, default=21600)
    parser.add_argument(
        "--tasks",
        nargs="+",
        default=None,
        help="Optional task subset for sharded runs. Defaults to the clean low10 task list.",
    )
    args = parser.parse_args()
    if args.tasks:
        unknown = [task for task in args.tasks if task not in TEACHER_CLEAN_RATE]
        if unknown:
            raise ValueError(f"unknown task(s) for low10 references: {unknown}")
        TASKS = args.tasks
    launch(args)


if __name__ == "__main__":
    main()
